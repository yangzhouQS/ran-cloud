{
  "$schema": "https://raw.githubusercontent.com/nicegram/nicegram-ios-tauri-v2/refs/heads/tauri-v2/core/tauri-config-schema/schema.json",
  "productName": "ran-rs-desktop",
  "version": "0.1.0",
  "identifier": "com.ran.rsdesktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "开发一体化工具 - Desktop",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' plugin:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; frame-src plugin:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
